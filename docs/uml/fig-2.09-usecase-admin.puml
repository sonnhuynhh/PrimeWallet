@startuml Hinh_2_9_UseCase_Admin
title Hình 2.9 – Use Case: Chức năng Quản trị (Admin)
left to right direction
skinparam actorStyle awesome

actor "Admin" as Admin
actor "Hệ thống\n(Audit)" as System

rectangle "PrimeWallet Admin Module" {
  usecase "Đăng nhập Admin\n(role=ADMIN)" as UC1
  usecase "Xem danh sách User" as UC2
  usecase "Xem chi tiết User" as UC3
  usecase "Duyệt / Từ chối KYC" as UC4
  usecase "Khóa tài khoản User" as UC5
  usecase "Mở khóa tài khoản" as UC6
  usecase "Xem lịch sử giao dịch Fiat" as UC7
  usecase "Xem lịch sử Crypto\n(Etherscan)" as UC8
  usecase "Xem Audit Log" as UC9
  usecase "Xem thống kê Dashboard" as UC10
  usecase "Đối soát sổ cái\n(Reconcile)" as UC11
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11

UC4 ..> System : Ghi AuditLog
UC5 ..> System : Ghi AuditLog
UC6 ..> System : Ghi AuditLog
UC11 ..> System : So sánh balance vs ledger

note bottom of UC4
  PUT /api/v1/admin/users/{id}/kyc
end note

note bottom of UC11
  POST /api/v1/admin/reconcile
end note

@enduml
