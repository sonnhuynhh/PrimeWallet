# ==================== API BACKEND ====================
# Chọn MỘT trong các cách sau:

# 1) Điện thoại thật — cùng WiFi với máy dev (thay IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# 2) Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# 3) iOS Simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 4) Tunnel ngrok (điện thoại bất kỳ mạng nào) — chạy: npm run tunnel:backend
# EXPO_PUBLIC_API_BASE_URL=https://xxxx.ngrok-free.app

# EXPO_PUBLIC_ETHERSCAN_API_KEY=
# EXPO_PUBLIC_ALCHEMY_API_KEY=
# WalletConnect — https://cloud.walletconnect.com
EXPO_PUBLIC_WC_PROJECT_ID=80e0c0f0fff7672435126a0d74c51d07
