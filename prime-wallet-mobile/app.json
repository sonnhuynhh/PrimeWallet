{
  "expo": {
    "name": "Prime Wallet",
    "slug": "prime-wallet-mobile",
    "scheme": "primewallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonnhuynhh.primewallet"
    },
    "android": {
      "package": "com.sonnhuynhh.primewallet",
      "adaptiveIcon": {
        "backgroundColor": "#08111f"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ceaca125-ba99-4093-ab50-fc60d69de2fc"
      }
    },
    "owner": "guguhys-team"
  }
}
